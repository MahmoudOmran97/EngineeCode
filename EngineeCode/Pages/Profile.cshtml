@page
@model EngineeCode.Pages.ProfileModel
@{
    ViewData["Title"] = "حسابي";
    Layout = "_Layout";
}

<style>
    .profile-hero {
        text-align: center;
        padding: 50px 24px 40px;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border);
    }

    [data-theme="dark"] .profile-hero {
        background: linear-gradient(135deg, #0a1628 0%, #0d1f3c 50%, #0a1628 100%);
    }

    [data-theme="light"] .profile-hero {
        background: linear-gradient(135deg, #e8f0fe 0%, #f0f4ff 50%, #e8f0fe 100%);
    }

    .profile-body {
        max-width: 960px;
        margin: 32px auto;
        padding: 0 24px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 24px;
        align-items: start;
    }

    /* ✅ الطلب قابل للنقر */
    .order-card {
        cursor: pointer;
        text-decoration: none;
        display: block;
        color: inherit;
        transition: border-color .2s, transform .15s;
    }

        .order-card:hover {
            border-color: var(--gold) !important;
            transform: translateY(-2px);
        }

    .order-card-arrow {
        color: var(--text-muted);
        font-size: 16px;
        transition: color .2s;
    }

    .order-card:hover .order-card-arrow {
        color: var(--gold);
    }

    @@media (max-width: 768px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }

        .stats-row {
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
        }

        .stat-number {
            font-size: 24px !important;
        }
    }

    @@media (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr;
        }

        .profile-body {
            padding: 0 16px;
        }
    }
</style>

<div class="profile-hero">
    <div class="avatar-circle" style="margin:0 auto 16px;">
        @(Model.Customer?.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
    </div>
    <div class="customer-name">@(Model.Customer?.Name ?? "—")</div>
    <div class="customer-email" style="direction:ltr;">@(Model.Customer?.Email ?? "—")</div>
    <div class="customer-since">
        عميل منذ @(Model.Customer?.CreatedAt.ToString("MMMM yyyy") ?? "—")
    </div>
</div>

<div class="profile-body">

    <div class="stats-row">
        <div class="profile-stat-box">
            <div class="stat-number">@Model.Orders.Count</div>
            <div class="stat-label">إجمالي الطلبات</div>
        </div>
        <div class="profile-stat-box">
            <div class="stat-number">@Model.Orders.Count(o => o.Status == "Delivered" || o.StatusInt == 3)</div>
            <div class="stat-label">تم تسليمها</div>
        </div>
        <div class="profile-stat-box">
            <div class="stat-number">@Model.Orders.Sum(o => o.Total).ToString("N0")</div>
            <div class="stat-label">جنيه إجمالي</div>
        </div>
    </div>

    <div class="profile-grid">

        <!-- بيانات العميل -->
        <div>
            <div class="info-card">
                <h5>📋 بياناتك الشخصية</h5>
                <div class="info-row">
                    <span class="info-label">الاسم</span>
                    <span>@(Model.Customer?.Name ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">الهاتف</span>
                    <span style="direction:ltr;">@(string.IsNullOrEmpty(Model.Customer?.Phone) ? "—" : Model.Customer.Phone)</span>
                </div>
                <div class="info-row">
                    <span class="info-label">الإيميل</span>
                    <span style="direction:ltr; font-size:13px;">@(Model.Customer?.Email ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">المدينة</span>
                    <span>@(string.IsNullOrEmpty(Model.Customer?.City) ? "—" : Model.Customer.City)</span>
                </div>
                <div class="info-row">
                    <span class="info-label">العنوان</span>
                    <span style="font-size:13px;">@(string.IsNullOrEmpty(Model.Customer?.Address) ? "—" : Model.Customer.Address)</span>
                </div>
            </div>
            <button class="btn-logout" style="width:100%; margin-top:12px;" onclick="logout()">
                🚪 تسجيل الخروج
            </button>
        </div>

        <!-- الطلبات -->
        <div>
            <div class="info-card">
                <h5>📦 طلباتي (@Model.Orders.Count)</h5>

                @if (!Model.Orders.Any())
                {
                    <div class="empty-orders">
                        <div class="icon">🛒</div>
                        <p>لم تقم بأي طلب بعد</p>
                        <a href="/Products" style="color:var(--gold); font-size:14px; text-decoration:none;">
                            تسوّق الآن ←
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                    {
                        <!-- ✅ الكارت كلها link للتفاصيل -->
                        <a href="/order/@order.Id" class="order-card" style="background:var(--bg-card);
                                   border:1px solid var(--border); border-radius:12px; padding:20px;
                                   margin-bottom:14px;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
                                <div>
                                    <div class="order-number">#@order.OrderNumber</div>
                                    <div class="order-date" style="direction:ltr;">
                                        @order.CreatedAt.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="badge-status badge-@order.FinalStatusColor">@order.FinalStatusText</span>
                                    <span class="order-card-arrow">←</span>
                                </div>
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <small style="color:var(--text-muted);">@order.Items.Sum(i => i.Quantity) منتج</small>
                                <div class="order-total">@order.Total.ToString("N0") ج</div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

    </div>
</div>

<script>
    async function logout() {
        await fetch('/api/proxy/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: '{}'
        });
        localStorage.removeItem('ec-customer');
        window.location.href = '/Login';
    }
</script>
