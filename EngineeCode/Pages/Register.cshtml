@page
@model EngineeCode.Pages.RegisterModel
@{
    ViewData["Title"] = "تسجيل حساب جديد";
    Layout = "_Layout";
}

<div class="login-wrapper">
    <div class="login-card" style="max-width:480px;">
        <div class="login-logo">
            <div class="brand">⚡ EngineeCode</div>
            <p>أنشئ حسابك وابدأ التسوق</p>
        </div>

        <div class="alert-custom alert-error" id="alertBox"></div>

        <!-- Step 1: البيانات الشخصية -->
        <div class="step active" id="step1">

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;">
                <div>
                    <label class="form-label">الاسم الكامل *</label>
                    <input type="text" class="form-control-custom" id="nameInput"
                           placeholder="محمد أحمد"
                           style="direction:rtl; text-align:right;" autocomplete="name" />
                </div>
                <div>
                    <label class="form-label">رقم الهاتف *</label>
                    <input type="tel" class="form-control-custom" id="phoneInput"
                           placeholder="01xxxxxxxxx"
                           style="direction:ltr; text-align:left;" autocomplete="tel" />
                </div>
            </div>

            <div style="margin-bottom:14px;">
                <label class="form-label">البريد الإلكتروني *</label>
                <input type="email" class="form-control-custom" id="emailInput"
                       placeholder="example@gmail.com"
                       style="direction:ltr; text-align:left;" autocomplete="email" />
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;">
                <div>
                    <label class="form-label">المحافظة</label>
                    <select class="form-control-custom" id="cityInput" style="direction:rtl; padding:12px 10px;">
                        <option value="">اختر (اختياري)</option>
                        <option>القاهرة</option>
                        <option>الجيزة</option>
                        <option>الإسكندرية</option>
                        <option>الدقهلية</option>
                        <option>الشرقية</option>
                        <option>القليوبية</option>
                        <option>كفر الشيخ</option>
                        <option>الغربية</option>
                        <option>المنوفية</option>
                        <option>البحيرة</option>
                        <option>الإسماعيلية</option>
                        <option>بورسعيد</option>
                        <option>السويس</option>
                        <option>الفيوم</option>
                        <option>بني سويف</option>
                        <option>المنيا</option>
                        <option>أسيوط</option>
                        <option>سوهاج</option>
                        <option>قنا</option>
                        <option>الأقصر</option>
                        <option>أسوان</option>
                        <option>مطروح</option>
                        <option>شمال سيناء</option>
                        <option>جنوب سيناء</option>
                        <option>البحر الأحمر</option>
                        <option>الوادي الجديد</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">العنوان التفصيلي</label>
                    <input type="text" class="form-control-custom" id="addressInput"
                           placeholder="الشارع، المنطقة..."
                           style="direction:rtl; text-align:right;" autocomplete="street-address" />
                </div>
            </div>

            <button class="btn-gold" id="sendOtpBtn" onclick="sendOtp()">
                التالي — إرسال كود التحقق
                <span class="spinner" id="spinner1"></span>
            </button>

            <p style="text-align:center; margin-top:18px; color:#888; font-size:13px;">
                عندك حساب بالفعل؟
                <a href="/Login" style="color:var(--gold); text-decoration:none; font-weight:600;">سجّل دخولك</a>
            </p>
        </div>

        <!-- Step 2: كود OTP -->
        <div class="step" id="step2">
            <p style="color:#aaa; font-size:14px; text-align:center; margin-bottom:10px;">
                تم إرسال كود التحقق إلى
            </p>
            <div class="email-display" id="emailDisplay"></div>

            <div class="otp-container">
                <input type="text" class="otp-input" maxlength="1" id="otp0" inputmode="numeric" />
                <input type="text" class="otp-input" maxlength="1" id="otp1" inputmode="numeric" />
                <input type="text" class="otp-input" maxlength="1" id="otp2" inputmode="numeric" />
                <input type="text" class="otp-input" maxlength="1" id="otp3" inputmode="numeric" />
                <input type="text" class="otp-input" maxlength="1" id="otp4" inputmode="numeric" />
                <input type="text" class="otp-input" maxlength="1" id="otp5" inputmode="numeric" />
            </div>

            <div class="timer-text">
                الكود صالح لمدة <span id="timerDisplay">10:00</span>
            </div>
            <button class="resend-btn" id="resendBtn" onclick="sendOtp(true)">
                إعادة إرسال الكود
            </button>

            <button class="btn-gold" id="verifyBtn" onclick="registerWithOtp()">
                تأكيد وإنشاء الحساب ✅
                <span class="spinner" id="spinner2"></span>
            </button>

            <button onclick="goBack()" style="width:100%; background:none; border:1px solid #333;
                    border-radius:10px; padding:12px; color:#888; cursor:pointer; margin-top:10px;
                    font-size:14px; font-family:inherit;">
                ← تعديل البيانات
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var userEmail = '';
        var timerInterval = null;

        // ===== OTP Inputs =====
        document.querySelectorAll('.otp-input').forEach(function(input, i, inputs) {
            input.addEventListener('input', function(e) {
                var val = e.target.value.replace(/[^0-9]/g, '');
                e.target.value = val;
                if (val) {
                    e.target.classList.add('filled');
                    if (i < inputs.length - 1) inputs[i + 1].focus();
                } else {
                    e.target.classList.remove('filled');
                }
                if (Array.from(inputs).every(function(inp) { return inp.value !== ''; })) {
                    registerWithOtp();
                }
            });
            input.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' && !input.value && i > 0) {
                    inputs[i - 1].focus();
                    inputs[i - 1].value = '';
                    inputs[i - 1].classList.remove('filled');
                }
            });
            input.addEventListener('paste', function(e) {
                var pasted = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
                pasted.split('').forEach(function(ch, idx) {
                    if (inputs[idx]) { inputs[idx].value = ch; inputs[idx].classList.add('filled'); }
                });
                e.preventDefault();
                if (pasted.length === 6) registerWithOtp();
            });
        });

        // ===== Validate Step 1 =====
        function validateStep1() {
            var name  = document.getElementById('nameInput').value.trim();
            var phone = document.getElementById('phoneInput').value.trim();
            var email = document.getElementById('emailInput').value.trim();

            if (!name || name.length < 2) {
                showAlert('من فضلك أدخل اسمك الكامل (حرفان على الأقل)'); return false;
            }
            if (!phone || !/^01[0-9]{9}$/.test(phone)) {
                showAlert('رقم الهاتف يجب أن يكون 11 رقم ويبدأ بـ 01'); return false;
            }
            if (!email || !email.includes('@@') || !email.includes('.')) {
                showAlert('من فضلك أدخل بريد إلكتروني صحيح'); return false;
            }
            return true;
        }

        // ===== Send OTP =====
        function sendOtp(isResend) {
            isResend = isResend || false;
            if (!isResend && !validateStep1()) return;

            var email = isResend ? userEmail : document.getElementById('emailInput').value.trim();

            setLoading('sendOtpBtn', 'spinner1', true);
            hideAlert();

            fetch('/api/proxy/send-otp-register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    userEmail = email;
                    document.getElementById('emailDisplay').textContent = email;
                    showStep('step2');
                    startTimer(600);
                    document.getElementById('otp0').focus();
                } else {
                    if (data.message && (data.message.includes('مسجل') || data.message.includes('موجود'))) {
                        showAlert('هذا الإيميل مسجل بالفعل. <a href="/Login" style="color:var(--gold);">سجّل دخولك</a>');
                    } else {
                        showAlert(data.message || 'حدث خطأ في إرسال الكود');
                    }
                }
            })
            .catch(function() { showAlert('فشل الاتصال بالسيرفر'); })
            .finally(function() { setLoading('sendOtpBtn', 'spinner1', false); });
        }

        // ===== Register مع الـ OTP في نفس الـ Request =====
        function registerWithOtp() {
            var inputs = document.querySelectorAll('.otp-input');
            var code = Array.from(inputs).map(function(inp) { return inp.value; }).join('');
            if (code.length !== 6) { showAlert('من فضلك أكمل كود التحقق'); return; }

            setLoading('verifyBtn', 'spinner2', true);
            hideAlert();

            // ✅ بنبعت الـ OTP مع بيانات التسجيل في request واحد
            fetch('/api/proxy/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name:    document.getElementById('nameInput').value.trim(),
                    phone:   document.getElementById('phoneInput').value.trim(),
                    email:   userEmail,
                    city:    document.getElementById('cityInput').value,
                    address: document.getElementById('addressInput').value.trim(),
                    otpCode: code
                })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    clearInterval(timerInterval);
                    var returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/Profile';
                    window.location.href = returnUrl;
                } else {
                    showAlert(data.message || 'حدث خطأ في إنشاء الحساب');
                    // لو الكود غلط، فضي الـ inputs
                    if (data.message && (data.message.includes('كود') || data.message.includes('OTP') || data.message.includes('التحقق'))) {
                        document.querySelectorAll('.otp-input').forEach(function(inp) {
                            inp.value = ''; inp.classList.remove('filled');
                        });
                        document.getElementById('otp0').focus();
                    }
                }
            })
            .catch(function() { showAlert('فشل الاتصال بالسيرفر'); })
            .finally(function() { setLoading('verifyBtn', 'spinner2', false); });
        }

        // ===== Timer =====
        function startTimer(seconds) {
            clearInterval(timerInterval);
            var display = document.getElementById('timerDisplay');
            var resendBtn = document.getElementById('resendBtn');
            resendBtn.style.display = 'none';

            timerInterval = setInterval(function() {
                var m = Math.floor(seconds / 60);
                var s = seconds % 60;
                display.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                if (seconds <= 0) {
                    clearInterval(timerInterval);
                    display.textContent = '0:00';
                    resendBtn.style.display = 'block';
                }
                seconds--;
            }, 1000);
        }

        // ===== Helpers =====
        function showStep(id) {
            document.querySelectorAll('.step').forEach(function(s) { s.classList.remove('active'); });
            document.getElementById(id).classList.add('active');
        }

        function goBack() {
            clearInterval(timerInterval);
            showStep('step1');
            hideAlert();
            document.querySelectorAll('.otp-input').forEach(function(inp) {
                inp.value = ''; inp.classList.remove('filled');
            });
        }

        function showAlert(msg) {
            var el = document.getElementById('alertBox');
            el.innerHTML = msg;
            el.style.display = 'block';
        }

        function hideAlert() {
            document.getElementById('alertBox').style.display = 'none';
        }

        function setLoading(btnId, spinnerId, loading) {
            document.getElementById(btnId).disabled = loading;
            document.getElementById(spinnerId).style.display = loading ? 'inline-block' : 'none';
        }

        document.getElementById('emailInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') sendOtp();
        });
    </script>
}
