<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark" id="htmlRoot">
<script>
    (function() {
        var theme = localStorage.getItem('ec_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
    })();
</script>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — EngineeCode</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Exo+2:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
          integrity="sha384-dpuaG1suU0eT09tx937/PpDDgBx+Rd3CY3U1bFMFHYKBFGXRVt1EQ4TmLTgAkFe"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ── Social icons في الفوتر ── */
        .footer-social {
            display: flex;
            gap: 14px;
            margin-top: 14px;
            align-items: center;
        }

            .footer-social a {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                color: var(--text-muted);
                font-size: 13px;
                transition: color .25s, transform .25s;
            }

                .footer-social a:hover {
                    color: var(--text-primary);
                    transform: translateY(-2px);
                }

            .footer-social img {
                width: 28px;
                height: 28px;
                object-fit: contain;
                border-radius: 6px;
            }

        /* ── زر الواتساب العائم ── */
        .wa-float {
            position: fixed;
            bottom: 24px;
            left: 24px; /* يسار لأن الموقع RTL */
            z-index: 9999;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #25d366;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 16px rgba(37,211,102,.45);
            transition: transform .25s, box-shadow .25s;
        }

            .wa-float:hover {
                transform: scale(1.12);
                box-shadow: 0 6px 22px rgba(37,211,102,.6);
            }

            .wa-float img {
                width: 28px;
                height: 28px;
            }
    </style>
</head>
<body>
    <div class="bg-mesh"></div>
    <div class="bg-grid"></div>
    <partial name="_Navbar" />

    <main style="padding-top: 68px; min-height: calc(100vh - 68px - 220px);">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="site-footer">
        <div class="footer-inner">

            <!-- Brand + Logo + Social -->
            <div class="footer-brand">
                <!-- اللوجو فوق الكلام -->
                <div style="display:flex; flex-direction:column; align-items:center; text-align:center; gap:8px;">
                    <img src="~/images/logo.png"
                         alt="EngineeCode Logo"
                         style="width:120px; height:120px; object-fit:contain; border-radius:14px;" />
                    <div style="font-family:'Exo 2',sans-serif; font-size:20px; font-weight:900; color:var(--text-primary);">
                        Enginee<span style="color:var(--blue-glow);">Code</span>
                    </div>
                    <div style="font-size:12px; color:var(--text-muted);">
                        لمستلزمات الكمبيوتر والكاميرات
                    </div>
                </div>
            </div>

            <div class="footer-links">
                <div class="footer-col">
                    <div class="footer-col-title">روابط سريعة</div>
                    <a href="/">الرئيسية</a>
                    <a href="/Products">المنتجات</a>
                    <a href="/Services">الخدمات</a>
                    <a href="/Cashier">نظام الكاشير</a>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">حسابي</div>
                    <a href="/Profile">طلباتي</a>
                    <a href="/Cart">السلة</a>
                    <a href="/Login">تسجيل الدخول</a>
                    <a href="/About">من نحن</a>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">تواصل معنا</div>
                    <a href="https://wa.me/201118324397" target="_blank">
                        <img src="~/images/whatsapp.png" alt="" style="width:16px;vertical-align:middle;margin-left:4px;" />
                        واتساب
                    </a>
                    <a href="/Contact">📩 تواصل معنا</a>
                    <a href="https://www.facebook.com/profile.php?id=61565693706435" target="_blank">
                        <img src="~/images/facebook.png" alt="" style="width:16px;vertical-align:middle;margin-left:4px;" />
                        فيسبوك
                    </a>
                </div>
            </div>

        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year EngineeCode — جميع الحقوق محفوظة</span>
        </div>
    </footer>

    <!-- زر واتساب عائم بأيقونة من images -->
    <a class="wa-float"
       href="https://wa.me/201118324397?text=مرحباً، أريد الاستفسار"
       target="_blank"
       title="تواصل عبر واتساب">
        <img src="~/images/whatsapp.png" alt="WhatsApp" />
    </a>

    <div class="toast" id="toast">
        <div class="toast-icon" id="toastIcon">✅</div>
        <div class="toast-text" id="toastText">تمت العملية بنجاح</div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
