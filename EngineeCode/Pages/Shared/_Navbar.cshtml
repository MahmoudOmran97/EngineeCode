@{
    Layout = null;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
    var customerEmail = Context.Session.GetString("CustomerEmail");
    var customerName = Context.Session.GetString("CustomerName");
    var isLoggedIn = !string.IsNullOrEmpty(customerEmail);
    var displayName = !string.IsNullOrEmpty(customerName) ? customerName : customerEmail;
    var initial = (displayName ?? "؟").Substring(0, 1).ToUpper();
}

<header class="navbar">
    <div class="nav-inner">
        <a class="logo" asp-page="/Index" style="gap:8px; align-items:center;">
            <img src="~/images/logo.png" alt="EngineeCode"
                 style="width:80px; height:80px; object-fit:contain; border-radius:3px; display:block;" />
            <div>
                <div class="logo-name">Enginee<em>Code</em></div>
                <div class="logo-tagline">لمستلزمات الكمبيوتر والكاميرات</div>
            </div>
        </a>

        <nav class="main-nav">
            <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">الرئيسية</a>
            <a class="nav-link @(currentPage == "/Products" ? "active" : "")" asp-page="/Products">المنتجات</a>
            <a class="nav-link @(currentPage == "/Services" ? "active" : "")" asp-page="/Services">الخدمات</a>
            <a class="nav-link @(currentPage == "/Cashier" ? "active" : "")" asp-page="/Cashier">نظام الكاشير</a>
            <a class="nav-link @(currentPage == "/About" ? "active" : "")" asp-page="/About">من نحن</a>
            <a class="nav-link @(currentPage == "/Contact" ? "active" : "")" asp-page="/Contact">تواصل معنا</a>
        </nav>

        <div class="nav-actions">
            <!-- زرار السلة -->
            <a class="cart-btn" href="/Cart" title="العربة">
                🛒
                <span class="cart-count" id="cartCount" style="display:none;">0</span>
            </a>

            @if (isLoggedIn)
            {
                <div class="customer-menu" id="customerMenu">
                   <button class="customer-btn" onclick="toggleCustomerMenu()">
    <span style="width:30px; height:30px; background:linear-gradient(135deg,#c9a84c,#7a5c1e);
                 border-radius:50%; display:inline-flex; align-items:center;
                 justify-content:center; font-size:13px; font-weight:700; color:#000;">
        @initial
    </span>
    <span class="nav-username">@(displayName?.Split(' ')[0])</span>
    <span class="nav-arrow" style="font-size:10px;">▾</span>
</button>
                    <div class="customer-dropdown" id="customerDropdown">
                        <a href="/Profile" style="display:block; padding:12px 16px; color:inherit;
                                                   text-decoration:none; font-size:14px; border-bottom:1px solid var(--border);">
                            👤 حسابي وطلباتي
                        </a>
                        <a href="/Cart" style="display:block; padding:12px 16px; color:inherit;
                                               text-decoration:none; font-size:14px; border-bottom:1px solid var(--border);">
                            🛒 سلة التسوق
                        </a>
                        <button onclick="logout()" style="display:block; width:100%; padding:12px 16px;
                                background:none; border:none; color:#ea868f; font-size:14px;
                                font-family:inherit; cursor:pointer; text-align:right;">
                            🚪 تسجيل الخروج
                        </button>
                    </div>
                </div>
            }
            else
            {
                <button class="nav-cta nav-login-btn" onclick="window.location.href='/Login'">
    <img src="~/images/login.png" alt="login" 
         style="width:18px; height:18px; object-fit:contain; vertical-align:middle;" />
    <span class="login-text">تسجيل الدخول</span>
</button>
            }
        </div>

        <!-- Theme Toggle — ظاهر دايمًا -->
        <button class="theme-toggle" onclick="navToggleTheme()" title="تبديل الوضع">
            <span class="theme-icon sun">☀️</span>
            <span class="theme-icon moon">🌙</span>
        </button>

        <!-- Hamburger -->
        <div class="hamburger" id="hamburgerBtn" onclick="navToggleMobile()">
            <span></span><span></span><span></span>
        </div>
    </div>
</header>

<!-- Mobile Nav -->
<div class="mobile-nav" id="mobileNav">
    <a class="nav-link" asp-page="/Index">🏠 الرئيسية</a>
    <a class="nav-link" asp-page="/Products">🛒 المنتجات</a>
    <a class="nav-link" asp-page="/Services">⚙️ الخدمات</a>
    <a class="nav-link" asp-page="/Cashier">🖥️ نظام الكاشير</a>
    <a class="nav-link" asp-page="/About">ℹ️ من نحن</a>
    <a class="nav-link" asp-page="/Contact">📞 تواصل معنا</a>
    <a class="nav-link" href="/Cart">🛒 العربة (<span id="cartCountMobile">0</span>)</a>
    @if (isLoggedIn)
    {
        <a class="nav-link" asp-page="/Profile">👤 حسابي</a>
        <button class="nav-link" onclick="logout()"
                style="background:none; border:none; color:#ea868f; font-family:inherit; cursor:pointer; text-align:right; width:100%;">
            🚪 تسجيل الخروج
        </button>
    }
    else
    {
        <a class="nav-link" asp-page="/Login">👤 تسجيل الدخول</a>
    }

    <!-- زر الثيم داخل المنيو على الموبايل -->
    <div style="padding: 12px 16px; border-top: 1px solid var(--border); margin-top: 6px; display:flex; align-items:center; gap:12px;">
        <span style="color:var(--text-secondary); font-size:14px;">🌓 تغيير المظهر</span>
        <button class="theme-toggle" onclick="navToggleTheme()" title="تبديل الوضع" style="margin-right:auto;">
            <span class="theme-icon sun">☀️</span>
            <span class="theme-icon moon">🌙</span>
        </button>
    </div>
</div>

<script>
    // ── Cart count ──
    (function() {
        var cart = JSON.parse(localStorage.getItem('ec_cart') || '[]');
        var count = cart.reduce(function(s, i) { return s + i.qty; }, 0);
        var el = document.getElementById('cartCount');
        var elM = document.getElementById('cartCountMobile');
        if (count > 0 && el) { el.style.display = 'flex'; el.textContent = count; }
        if (elM) { elM.textContent = count; }
    })();

    // ── Theme — مستقل عن site.js ──
    function navToggleTheme() {
        var html = document.documentElement;
        var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('ec_theme', next);
        // لو site.js محملة كمان نحدثها
        if (typeof toggleTheme === 'function' && toggleTheme !== navToggleTheme) {
            // مش بنكرر — اتنفذت فعلاً
        }
    }

    // ── Mobile nav — مستقل عن site.js ──
    function navToggleMobile() {
        var nav = document.getElementById('mobileNav');
        if (nav) nav.classList.toggle('open');
    }

    // ── Customer menu ──
    function toggleCustomerMenu() {
        var dd = document.getElementById('customerDropdown');
        if (dd) dd.classList.toggle('open');
    }

    // Close customer menu when clicking outside
    document.addEventListener('click', function(e) {
        var menu = document.getElementById('customerMenu');
        if (menu && !menu.contains(e.target)) {
            var dd = document.getElementById('customerDropdown');
            if (dd) dd.classList.remove('open');
        }
        // Close mobile nav when clicking outside
        var mNav = document.getElementById('mobileNav');
        var hBtn = document.getElementById('hamburgerBtn');
        if (mNav && hBtn && !mNav.contains(e.target) && !hBtn.contains(e.target)) {
            mNav.classList.remove('open');
        }
    });

    // ── Logout ──
    function logout() {
        fetch('/api/proxy/logout', { method: 'POST' })
            .then(function() { window.location.href = '/'; });
    }
</script>
